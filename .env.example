# Names only. Real values live in Cloudflare Pages > Settings > Variables and Secrets.
# Never commit a real value. For local Pages Function tests use a git-ignored .dev.vars file.

# Brevo (transactional mail), secret
BREVO_API_KEY=
# Where enquiries are delivered
CONTACT_TO_EMAIL=
# Verified Brevo sender
CONTACT_FROM_EMAIL=
# Cloudflare Turnstile secret key, secret
TURNSTILE_SECRET_KEY=
# Cloudflare Turnstile site key, public (embedded in the page)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Canonical origin, no trailing slash
NEXT_PUBLIC_SITE_URL=
